Package: RRASSLER
Type: Package
Title: R based HEC-RAS model accounting wrestler
Version: 0.1.1
Authors@R: c(person(given = "Jim", family = "Coll", role = c("aut", "cre"), email = "james.coll@noaa.gov",comment = c(ORCID = "0000-0002-6994-6668")),
